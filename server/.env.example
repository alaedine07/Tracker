# Server
PORT=3000
NODE_ENV=development
JWT_SECRET=dev-jwt-secret-change-in-production-min32chars
ENCRYPTION_KEY=dev-encryption-key-change-in-prod-32ch

# Database
DATABASE_URL=postgresql://musicmanager:musicmanager_dev@localhost:5432/musicmanager

# Redis
REDIS_URL=redis://localhost:6379

# Spotify
SPOTIFY_CLIENT_ID=<your-spotify-client-id>
SPOTIFY_CLIENT_SECRET=<your-spotify-client-secret>
SPOTIFY_REDIRECT_URI=musicmanager://callback

# Last.fm
LASTFM_API_KEY=<your-lastfm-api-key>

# OpenRouter
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_MODEL=openai/gpt-4o-mini
